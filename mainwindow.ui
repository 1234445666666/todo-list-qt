       <string notr="true">/* Настраиваем главное окно */
QMainWindow {
    background-color: #1e1e24; /* Темный красивый фон */
}

/* Настраиваем текстовое поле (Инпут) */
QLineEdit {
    background-color: #2a2a32;
    color: #ffffff;
    border: 1px solid #4e4e5a;
    border-radius: 6px;
    padding: 8px;
    font-size: 14px;
}

/* Настраиваем список задач */
QListWidget {
    background-color: #2a2a32;
    color: #ffffff;
    border: 1px solid #4e4e5a;
    border-radius: 6px;
    padding: 5px;
    font-size: 14px;
}

/* Настраиваем элементы списка при выделении */
QListWidget::item:selected {
    background-color: #007acc; /* Красивое синее выделение вместо зеленого */
    color: white;
}

/* Настраиваем ВСЕ кнопки сразу */
QPushButton {
    background-color: #007acc;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 15px;
    font-size: 13px;
    font-weight: bold;
}

/* Эффект при наведении мышки на кнопку */
QPushButton:hover {
    background-color: #0098ff;
}

/* Эффект при нажатии на кнопку */
QPushButton:pressed {
    background-color: #005999;
}
</string>
